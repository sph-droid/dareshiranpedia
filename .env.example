# 誰もしらんペディア 環境変数（Vercel の Project Settings → Environment Variables に設定）
# このファイル自体には本物の値を書かないこと。

# Supabase プロジェクトのURL（Settings → API → Project URL）
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase のサービスロールキー（Settings → API Keys の secret / service_role）
# 秘密情報。フロントエンドや GitHub のコードには絶対に書かない。
SUPABASE_SERVICE_KEY=

# IPアドレスをハッシュ化するときのソルト（推測できないランダムな文字列）
IP_HASH_SALT=

# 管理者の Supabase Auth ユーザーID（Authentication → Users で確認）
ADMIN_USER_ID=

# 管理セッションCookieの署名用シークレット（推測できないランダムな文字列）
ADMIN_SESSION_SECRET=

# 任意: Cloudflare Turnstile のシークレットキー。
# 設定すると投稿・編集・復元・報告・アップロードで Turnstile 検証が有効になる。
# 使う場合は public/config.js の turnstileSiteKey にサイトキーも設定すること。
TURNSTILE_SECRET=
